# API Server configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=*

# PostgreSQL Database Connection URL (used by Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/programming_mastery?schema=public"

# Better Auth configuration
# Generate a secret key (e.g. openssl rand -base64 32 or any 32-char string)
BETTER_AUTH_SECRET="some_random_secret_at_least_32_characters_long"
BETTER_AUTH_URL="http://localhost:4000/api/auth"
